APP_NAME=DigiPrenda
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Código de Organización (2 dígitos) para generación de códigos de crédito
# Ejemplo: 01, 02, 10, 99
ORGANIZATION_CODE=01


APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/Guatemala

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Configuración del Módulo Contable
CONTABILIDAD_AUTO_ASIENTOS=true
CONTABILIDAD_AUTO_DESEMBOLSO=true
CONTABILIDAD_AUTO_PAGO=true
CONTABILIDAD_AUTO_VENTA=true
CONTABILIDAD_AUTO_COMPRA=true
CONTABILIDAD_REQUIERE_APROBACION=false
CONTABILIDAD_MONEDA=GTQ
CONTABILIDAD_LOG=true

# GROQ AI API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Security Configuration
SECURITY_ENABLE_AUDIT_LOG=true
SECURITY_ENABLE_RATE_LIMITING=true
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_MINUTES=15

# Módulo legado de empeños (código conservado, no operativo en Parcelia)
# true = UI y endpoints de prendas/créditos/remates disponibles
EMPENOS_ENABLED=false

# Umbral IVE efectivo (US$10,000 o equivalente) para venta de terrenos
INMOBILIARIO_AML_UMBRAL_USD=10000
INMOBILIARIO_AML_TIPO_CAMBIO_GTQ=7.80

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

VITE_APP_NAME="${APP_NAME}"

# TEKRA Electronic Invoicing (FEL) Configuration
TEKRA_ENABLED=false
TEKRA_USER=tekra_api
TEKRA_PASSWORD=123456789
TEKRA_CLIENT=2121010001
TEKRA_CONTRACT=2122010001
TEKRA_SOAP_URL=http://apicertificacion.desa.tekra.com.gt:8080/certificacion/servicio.php
TEKRA_REST_URL=https://apiseguimiento.tekra.com.gt
TEKRA_EMISOR_NIT=107346834
TEKRA_EMISOR_NOMBRE="TEKRA SOCIEDAD ANONIMA"
TEKRA_EMISOR_NOMBRE_COMERCIAL="TEKRA SOCIEDAD ANONIMA"
TEKRA_EMISOR_DIRECCION="19 CALLE 18-48"
TEKRA_EMISOR_MUNICIPIO="GUATEMALA"
TEKRA_EMISOR_DEPARTAMENTO="GUATEMALA"
TEKRA_EMISOR_CODIGO_POSTAL="01010"
TEKRA_EMISOR_AFILIACION_IVA=GEN

